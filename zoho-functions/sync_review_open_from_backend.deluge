// REST API Function
// Purpose: update one Lead/Contact immediately after the backend records a review-link open.

request_body = crmAPIRequest.get("body");
if(request_body == null)
{
	return "missing_body";
}

module_api_name = request_body.get("module_api_name");
crm_record_id = request_body.get("crm_record_id");
review_link = request_body.get("review_link");
open_count = request_body.get("open_count");
opened_at = request_body.get("opened_at");
open_status = request_body.get("review_page_open_status");

if(module_api_name == null || crm_record_id == null)
{
	return "missing_record";
}

try
{
	record_data = zoho.crm.getRecordById(module_api_name, crm_record_id.toLong());
	current_status = ifnull(record_data.get("googlereviewlink__Review_Page_Open_Status"), "");

	update_fields = Map();
	if(review_link != null && review_link != "")
	{
		update_fields.put("googlereviewlink__Google_Review_Link", review_link);
	}
	if(open_count != null)
	{
		update_fields.put("googlereviewlink__Review_Page_Open_Count", open_count);
	}
	if(opened_at != null && opened_at != "")
	{
		update_fields.put("googlereviewlink__Last_Review_Page_Opened_At", opened_at);
	}
	if(current_status != "Review Left" && open_status != null && open_status != "")
	{
		update_fields.put("googlereviewlink__Review_Page_Open_Status", open_status);
	}

	if(update_fields.size() > 0)
	{
		update_response = zoho.crm.updateRecord(module_api_name, crm_record_id.toLong(), update_fields);
		info update_response;
		response_code = update_response.get("code");
		response_status = update_response.get("status");
		if((response_code != null && response_code != "SUCCESS") || response_status == "error")
		{
			return "failed: updateRecord rejected " + update_response.toString();
		}
	}
	return "synced";
}
catch(e)
{
	info e;
	return "failed: " + e.toString();
}
